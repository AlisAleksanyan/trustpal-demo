# TrustPal local development. Never put secrets in VITE_ variables.
# This public demo is hard-locked to Sandbox; any other value stops startup.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Configure after a public webhook endpoint is available.
PAYPAL_WEBHOOK_ID=

# Sandbox recipient mappings for real multi-seller checkout.
# Keys are cause IDs, values are the associated Sandbox seller merchant IDs.
# Example: {"armenia-learning":"SELLER_MERCHANT_ID"}
PAYPAL_RECIPIENTS_JSON={}

# Optional US/USD Venmo testing. Checkout must check actual buyer eligibility.
PAYPAL_ENABLE_VENMO=false

# Astropods is a PayPal AI Hackathon partner. Credentials remain server-only.
# Astropods deployments inject the URL and key; for local development configure
# them through the Astropods project workflow rather than committing values.
ASTRO_GATEWAY_URL=
ASTRO_GATEWAY_API_KEY=
# Local-development fallback. Astropods injects MODEL_IMPACT in deployments.
ASTRO_MODEL=gpt-5-6-terra

# Optional AG Studio browser licence. The server delivers this value to the
# Studio component at runtime; it is not a PayPal/OpenAI API credential.
AG_STUDIO_LICENSE_KEY=

# Optional approved-steward access. Generate a random token of at least 32 characters.
# Keep server-side; never use a VITE_ prefix. Without it, verification stays locked.
STEWARD_ACCESS_TOKEN=
